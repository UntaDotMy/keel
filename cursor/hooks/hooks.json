{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash ~/.cursor/hooks/keel-cursor.sh",
        "matcher": "Write|Edit|Delete|Shell|Read|Grep",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "bash ~/.cursor/hooks/keel-cursor.sh",
        "matcher": "Shell",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "bash ~/.cursor/hooks/keel-cursor.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "bash ~/.cursor/hooks/keel-cursor.sh",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "bash ~/.cursor/hooks/keel-cursor.sh",
        "timeout": 5
      }
    ]
  }
}
