{
  "$schema": "https://json.schemastore.org/claude-code-lsp.json",
  "rust-analyzer": {
    "command": "rust-analyzer",
    "args": [],
    "extensionToLanguage": {
      ".rs": "rust"
    },
    "settings": {
      "rust-analyzer": {
        "cargo": {
          "buildScripts": {
            "enable": true
          }
        },
        "check": {
          "command": "clippy"
        }
      }
    },
    "maxRestarts": 3,
    "diagnostics": true
  }
}
